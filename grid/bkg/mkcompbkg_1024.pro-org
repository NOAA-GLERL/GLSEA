plot, axis_arr, /nodata, xrange=[0,1], yrange=[0,30],  $
	   position=[bar_x, bar_y, bar_x+bar_w, bar_y+bar_h],   $
	   /device, xstyle=4, ystyle=4, /noerase
	   
