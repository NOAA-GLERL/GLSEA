/******************************************************************************/
 
int writeImageIntoTif (TIFF * fh_tif, void *img ) {
 
  int ioutbyte, rc, i, j;
  int rows, cols;
    
  unsigned char * outline = NULL;    
  unsigned char *img1024 = NULL;

  rows = SIZE_1024;  
  cols = SIZE_1024; 
             
  outline = (char *)_TIFFmalloc(cols * sizeof(char));
     
  if ( outline == NULL ) {
     printf("Error allocate memory \n" );
     exit(0); 
  }

  img1024 = img; 
              
  for (j=0; j<rows; j++){              
     for (i=0; i<cols; i++){ 
        
        if ( *img1024 < 1 ) {
           ioutbyte = 0;
        }
        else if ( *img1024 > 255 )  
           ioutbyte = 255;
        else {
           ioutbyte = *img1024;                   
        }
                 
        img1024++;
                     
        outline[i] = (char)  ioutbyte;
    
      }   //  end for 
        
         if ((rc = TIFFWriteScanline(fh_tif, outline, j, 0)) < 0)  
                 printf ("Error writing data to %s\n",  fh_tif);
 }
//printf("%s\n", fh_tif);
 XTIFFClose(fh_tif);   
 
return 0;
}  
      
/******************************************************************************/

int getColor( char colorFn[], uint16_t red[], uint16_t green[], uint16_t blue[]) {

  FILE *fp, *fp2;
   
  int i, j, k, nc, nt, n1;
  unsigned char c;
  float tMax, tMin, cMin, cMax, res, t1, t2;
  char line[COLOR_NUM];
  char rStr[COLOR_NUM], gStr[COLOR_NUM], bStr[COLOR_NUM];
  char *strPt = line;
  char workDir[PATH_MAX];
 
//  clor table
//  0   0   0   30   black
//  70  70  70  29   light black
//  110 110 110 27   dark gray    
//  160 160 160 23   medium gray
//  190 190 190 17   light gray
//  220 220 220 11   off white
         
  if ( (fp = fopen(colorFn , "r")) == NULL ){
        printf("Error open %s\n", colorFn  );   
        exit(0);
   }
  
    fgets(line, COLOR_NUM, fp);   // read out a head string in pal file
 //   printf("%s\n", line);
  
  for ( i=0; i<256; i++ ) {
    
    fgets(line, COLOR_NUM, fp);
      //   printf("%s\n", line);

    strcpy(rStr, line);
    rStr[2] = 0;
    sscanf(rStr, "%x", &red[i]);
        
    strcpy(gStr, &line[2]);
    gStr[2] = 0;
    sscanf(gStr, "%x", &green[i]);

    strcpy(bStr, &line[4]);
    bStr[2] = 0;
    sscanf(bStr, "%x", &blue[i]);

   //printf("%d %d %d %d\n", i, red[i], green[i], blue[i]);
  }
            
   fclose(fp);
 
   sscanf("0", "%d", &red[30]  );   // black
   sscanf("0", "%d", &green[30]);
   sscanf("0", "%d", &blue[30] );  

   sscanf("70", "%d", &red[29]  );   // light black
   sscanf("70", "%d", &green[29]);
   sscanf("70", "%d", &blue[29] );   

   sscanf("110", "%d", &red[27]  );   // dark gray    
   sscanf("110", "%d", &green[27]);
   sscanf("110", "%d", &blue[27] );   

   sscanf("160", "%d", &red[23]  );    
   sscanf("160", "%d", &green[23]);
   sscanf("160", "%d", &blue[23] );   

   sscanf("190", "%d", &red[17]  );    
   sscanf("190", "%d", &green[17]);
   sscanf("190", "%d", &blue[17] );   

   sscanf("220", "%d", &red[11]  );    
   sscanf("220", "%d", &green[11]);
   sscanf("220", "%d", &blue[11] );   

// for ( i=0; i<256; i++ ) 
//   printf("%d %d %d %d\n", i, red[i], green[i], blue[i]);
 
   return 0;
}
       
/**********************************************************************/

unsigned short int byte_scale(float in_val, float mnval, float mxval, 
                                          unsigned short int maxbyte) {
float m,b,scaledin;
unsigned short int  output;
/*
    m = (float) (maxbyte - 1) / (mxval - mnval);
//printf("maxbyte = %i  max_val=%f  min_val=%f  m=%f \n",maxbyte,mxval,mnval,m);
    b = (float) (maxbyte - 1) - (mxval * m);

//printf("m=%f b=%f maxbyte=%f \n\n",m,b,maxbyte);

    if (in_val < mnval)
          in_val = mnval;
    if (in_val > mxval)
          in_val = mxval;

      scaledin = (m * in_val) + b;
*/
scaledin = ( maxbyte / mxval )* in_val;      
      output   = round (scaledin);

/*  printf("inval=%f scaledin=%f outoput=%i\n", in_val, scaledin, output);*/
 
  return (output);
}


/******************************************************************************/

/* convert from float, then to 8 bits */

//-----------------------------------------------------------------------------------
//  Color               Median Ice                  Color               Median Ice
//  index    SI Code   Concentration                index    SI Code    Concentration
//-----------------------------------------------------------------------------------
//   11          01          5                       24    68,70,77         70
//   -------------------------
//   12    02,10,11         10                       25          78         75
//                                                   26    79,80,88         80
//   13       12,15         15                       27          89         85
//                                                   -------------------------
//   14    13,20,22         20                       28       81,90         90
//   15          23         25                       29          91         95
//   16    24,30,33         30                       -------------------------
//   17          34         35                       30       92,93        100
//   -------------------------
//   18    35,40,44         40                     11-12  Off-white
//   19          45         45                     13-17  Light gray                   
//   20    46,50,55         50                     18-23  Medium gray
//   21          56         55                     24-27  Dark gray
//   22    57,60,66         60                     28-29  Light Blak
//   23          67         65                     30-30  Black
//-----------------------------------------------------------------------------------


int calibrate(float *fltImg, unsigned char *img8 ) {

   int i, j, r1;
 
   // in composit.pal, each color take 5 line, 30 * 5 = 150
   // index under 50 is reserved
 
   for (i=0; i<SIZE_1024; i++) {
      for (j=0; j<SIZE_1024; j++) {

         if ( *fltImg == 255.0 )                                 // land
            *img8 = 255;
         else {
            
             if ( (*fltImg >= 99.0) && (*fltImg <= 99.1) )  {    // ice
               *fltImg = round((*fltImg - 99) * 1000);
                         
               if ( (*fltImg > 95) && (*fltImg <= 100) )  
                  *img8 = 30;                                    // black
             
               if ( (*fltImg >= 90) && (*fltImg <= 95) ) 
                 *img8 = 29;                                     // dark gray

               if ( (*fltImg >= 70) && (*fltImg <= 85) )  
                  *img8 = 27;                  

               if ( (*fltImg >= 40) && (*fltImg <= 65) ) 
                  *img8 = 23;
          
               if ( (*fltImg >= 10) && (*fltImg <= 35) )  
                  *img8 = 17;

               if ( *fltImg < 10 )  
                  *img8 = 11;                                       // off-white
            } 
            else {                                                   // water
               r1 = round(*fltImg /30. * 150);
               *img8 = r1 + 50;
               // printf("%d , %d , %f  %d\n", i, j, *fltImg, *img8);
            }
        }
          // printf("%d , %d , %f  %d\n", i, j, *fltImg, *img8);
          fltImg++;
          img8++;
       }
   }     
  
  return 0;
}

