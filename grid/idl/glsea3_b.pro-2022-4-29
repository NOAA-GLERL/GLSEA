	b_data2 = get_buoy_sst_r_c(station_fn, buoy_list, mask_fn, lmd_fn2 )
	
	b_sst = get_buoy_sst_increse( b_data, b_data2, water)
	;b_sst_arr = b_data.b_loc_sst
	;b_col_arr = b_data.b_loc_col
	;b_row_arr = b_data.b_loc_row	
	;print, b_data.b_loc_sst, b_data2.b_loc_sst
	
    ;ind = where(b_sst gt -100)

   ;..............................

   ; Run analysis for specified years and days

   for yra=yrstart,yrend do begin
      jd1=1
      if(yra eq yrstart) then jd1=jdstart 
      jd2=365
      if(yra mod 4 eq 0) then jd2=366
      if(yra eq yrend) then jd2=jdend
  
      for jda=jd1,jd2 do begin              ; each day, eg. from jd 11 to jd 21

         ; Calculate time differences from noon on target day

         j1=julday(1,1,yra)-julday(1,1,yrstart)+jda-0.5   
         dt=j0-j1

         ; Select files from time window

         kf=where(abs(dt) le dtmax,nkf)

         ;---------------------------------------
         ; special test for backward only:
         ;  kf=where(dt ge -dtmax and dt le 0.,nkf)
         ;---------------------------------------
  
         dt=dt(kf)
         jd=jd0(kf)
         hr=hr0(kf)
         fn=fns(kf)
         fb=fbs(kf)

         t = fltarr(nwater,nkf)     ; for sst
         d = fltarr(nwater,nkf)     ; for dtime

         ; get images and apply cloud masks

         for i=0,nkf-1 do begin

            ; Obtain next image name

            img0 = intarr(1024,1024)
            img  = fltarr(1024,1024)
            img(*,*) = -1.0

            dtime = lonarr(1024,1024)

            pack = get_img(fn(i))

            ; swap bytes on Intel architecture machines
            ;  byteorder,img

            img0 = pack.sst_arr
            img0(where(img0 eq pack.sst_miss_v)) = -1

            offset = 27315
            sst_scale = 0.01
            ;img = (pack.sst_arr(where(pack.sst_arr ne pack.sst_miss_v)) + offset ) * scale - 273.15
            ;( img(where(img ne -1)) + offset ) * scale - 273.15
            img(where (img0 ne -1)) = (img0(where (img0 ne -1)) + 27315 ) * sst_scale - 273.15

;            img=0.01*rotate(img,7)
 ;           img(land)=-1
            dtime0 = pack.dtime_arr
            dtime0(where(dtime0 eq pack.dtime_miss_v)) = -1
           
            dtime_scale = 0.25
            ; after time scale, convert second to jd
            dtime(where (dtime0 ne -1)) = dtime0(where (dtime0 ne -1)) * dtime_scale / (24.*60.*60.)

  
            ; Look for isolated pixels in open water (nghbr = 9)

            npix=bytarr(1024,1024)
            for ix=-1,1 do begin
               for jx=-1,1 do begin 
                  img2=shift(img,ix,jx)
                  k=where(img2 gt 0,nk)
                 if(nk gt 0) then npix(k)=npix(k)+1
               end
            end
            k=where(npix le 1 and nghbr eq 9 and img gt 0,nk)
            if (nk gt 0) then   img(k) = -1
            
     
            ; Check for unreasonable values

            k = where(img lt 0 or img gt 40.,nk)
            if (nk gt 0) then begin
               img(k)=-1
               dtime(k) = -1
            endif

            ; Store sst in 1-d array
  
            t(*,i) = img(water)
            d(*,i) = dtime(water)
         end  ; for i

         ; create today's image
 
         ; set up projected values from yesterday
  
         imgb=fltarr(1024,1024)-1
         ;;;imgb(water) = a2 + lakeavg1(lake) - lakeavg2(lake)
		 
		 avg_inc = lakeavg1(lake) - lakeavg2(lake)
		 
		 b_ind = where(b_sst gt -100)    ; buoy sst
		 s_ind = where(b_sst eq -100)    ; avg satellite sst
		 
		 a2(b_ind) = a2(b_ind) + b_sst(b_ind)
  
		 a2(s_ind) = a2(s_ind) + avg_inc(s_ind)
		 imgb(water) = a2
		  
		 

         ; scan available images & weight in space and time

         img=fltarr(1024,1024)
         avg=fltarr(1024,1024)
         wgt=fltarr(1024,1024)
         wt =fltarr(1024,1024)
        

         for i=0,nkf-1 do begin
;            wt=dtfac/(dtfac+dt(i)*dt(i)/dtmax2)
            img(water) = t(*,i)

            dt_sum = dt(i) + d(*,i)
            wt(water) = dtfac / (dtfac + dt_sum * dt_sum / dtmax2)
            for ix=-rmax,rmax do begin
               for jx=-rmax,rmax do begin
                  wr=rfac/(rfac+(ix*ix+jx*jx)/rmax2)
                  img2 = shift(img,ix,jx)
                  wt2 = shift(wt,ix,jx)
                  ; pixel with valid data

                  k = where(img2 gt 0 and lmask le 100,nk)
                  if (nk gt 0) then begin
              ;       avg(k)=avg(k)+wr*wt*img2(k)
                     
                     avg(k) = avg(k) + wr * wt2(k) * img2(k)
                     wgt(k) = wgt(k) + wr * wt2(k)
                  end
               end
            end
         end

         ; calculate interpolated values

         k = where(wgt gt 0,nk1)
         if(nk1 gt 0) then avg(k)=avg(k)/wgt(k)

         ; if there are no new sst data within +/- dtmax in time and
         ;  +/- rmax in space, use projected value from yesterday

         k = where(wgt le 0 and lmask le 100,nk3)
         if (nk3 gt 0) then begin
            avg(k) = imgb(k)
            ;print, "use prejected file from yesterday", nk3
         endif

         ; smooth boundary areas with 9-point smoother at edges between
         ;  areas with new interpolated sst data and areas with no new sst data

         tt=fltarr(1024,1024)
         np1=bytarr(1024,1024)
         for ix=-1,1 do begin
            for jx=-1,1 do begin 
               img2=shift(avg,ix,jx)
               tt=tt+img2
               img2=shift(wgt,ix,jx)
               ; count surrounding interpolated pixels
               k=where(nghbr eq 9 and img2 gt 0,nk)
               if(nk gt 0) then np1(k)=np1(k)+1
            end
         end
  
         ;  print, np1
         k=where(np1 gt 0 and np1 lt 9,nk2)
         if(nk2 gt 0) then avg(k)=tt(k)/9.

         ; check for negative temp

         a = avg(water)
         k=where(a lt 0,nk)
         if(nk gt 0) then a(k)=0

         ; create png image and save ascii data values

         img=img*0+255
         img(water)=a*256/30.
         tv,img
       
         y_m_d = get_year_month_day( yra, jda)
   
         str_yr = string(yra,format='(i4)')
         str_jd = string(jda,format='(i3.3)')

         xyouts,0.02,0.23,'YR:' + str_yr + ' JD:' + str_jd,/norm,color=0
         img=tvrd()
         img=img(*,110:909)
         fn = glsea_dir + '/' + str_yr + '_' + str_jd + '_glsea_c.png'
         write_png,fn,img,red,grn,blu
         fn = glsea_dir + '/' + str_yr + '_' + str_jd + '_glsea.dat'
         openw,1,fn
         printf,1, round(a*100)/100., format='(f5.2)'      ; from d.ddd to d.dd

         close,1
         
         ncepetagl_fn = glsea_dir + '/ncepetagl' + y_m_d + '.dat'
         glsea_png_fn = glsea_dir + '/' + str_yr + '_' + str_jd + '_glsea.png'
         glsea_asc_fn = glsea_dir + '/' + str_yr + '_' + str_jd + '_glsea.asc'
         glsea_i_fn   = glsea_dir + '/' + str_yr + '_' + str_jd + '_glsea_i.dat'

         asc_arr = fltarr(1024,1024)
         asc_arr(*,*) = 255.0
         asc_arr(water) = round(a * 100 ) /100.   ; from d.ddd to d.dd

         raw_ice = bytarr(1024,1024)              ; need for both ice season and non ice season

          ; calculate lakewide averages

            for l=0,5 do begin
               lakeavg2(l)=lakeavg1(l)
               k=where(lake eq l)
               lakeavg1(l)=mean(a(k))
            end            
 
         if ( jda le end_ice or jda ge begin_ice) then begin                   ; ice season
             
            ice_fn = get_ice_fn( ice_dir, yra, jda)
            ;raw_ice = bytarr(1024,1024)
                                
            if ( strlen(ice_fn) ne 0 ) then begin
               get_raw_ice, ice_fn, nb_fn, lmask, raw_ice     ; raw_ice will have same shoreline as lmask
               asc_fill_ice, raw_ice, asc_arr               
 
               lakeavg1 = agv_with_ice( raw_ice, lmask,  a )
            end  
            
            mk_glsea_i_dat, glsea_i_fn, asc_arr, water             
            mk_glsea_asc, glsea_asc_fn, asc_arr
;            mk_ncep_data, ncepetagl_fn, ncep_fn, ch_ncep_fn,  lmask, raw_ice, a, 1
      
      
            mk_glsea_png, glsea_png_fn, ice_fn, w_bk_fn, c_pal_fn, lmask, raw_ice, a, nk1, 1

         endif else begin                                                      ; non ice season
 ;           mk_ncep_data, ncepetagl_fn, ncep_fn, ch_ncep_fn,  lmask, raw_ice, a, 0
            mk_glsea_asc, glsea_asc_fn, asc_arr
            mk_glsea_png, glsea_png_fn, ice_fn, s_bk_fn, c_pal_fn, lmask, raw_ice, a, nk1, 0    ; in summer raw_ice is array of 0
;;;;;;;

         endelse
 
         ; output stats file:
         ;  nkf = number of sst files used in interpolation
         ;  nk1 = number of pixels filled with interpolated sst data
         ;  nk2 = number of pixels which were smoothed at edges between interpolated and projected values
         ;  nk3 = number of pixels filled with projected sst data
         ;
         ;  lakeavg1(0) = lake average sst for Lake Superior
         ;  lakeavg1(1) = lake average sst for Lake Michigan
         ;  lakeavg1(2) = lake average sst for Lake Huron
         ;  lakeavg1(3) = lake average sst for Lake St. Clair
         ;  lakeavg1(4) = lake average sst for Lake Erie
         ;  lakeavg1(5) = lake average sst for Lake Ontario
   
         print,yra,jda,nkf,nk1,nk2,nk3,lakeavg1,format='(6i8,6f7.2)'
         printf,2,yra,jda,nkf,nk1,nk2,nk3,lakeavg1,format='(6i8,6f7.2)'
         a2 = a

      end  ; for jda
   end     ; for yra

end
