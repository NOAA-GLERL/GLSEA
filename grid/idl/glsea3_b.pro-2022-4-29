   readf,lun, name, date, ncols,nrows,xllcorner,yllcorner,cellsize,NODATA_value 
   readf,lun,raw_ice
   raw_ice = rotate(temporary(raw_ice),7)

   openr, lun, nb_fn, /get_lun

